{#
  Custom Main Menu for Gold Theme
  File: menu--main.html.twig
#}
{% import _self as menus %}

<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container">
    <a class="navbar-brand" href="{{ path('<front>') }}">{{ site_name }}</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#goldMainNav" aria-controls="goldMainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="goldMainNav">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        {% for item in items %}
          {% if item.below %}
            <li class="nav-item dropdown {{ item.in_active_trail ? 'active' }}">
              <a class="nav-link dropdown-toggle" href="{{ item.url }}" id="menuItem{{ loop.index }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ item.title }}
              </a>
              <ul class="dropdown-menu" aria-labelledby="menuItem{{ loop.index }}">
                {% for sub_item in item.below %}
                  <li>
                    <a class="dropdown-item {{ sub_item.in_active_trail ? 'active' }}" href="{{ sub_item.url }}">
                      {{ sub_item.title }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="nav-item {{ item.in_active_trail ? 'active' }}">
              <a class="nav-link" href="{{ item.url }}">{{ item.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</nav>

