{# Wrapper for category listing rows #}
<!-- VIEW: category_listing rendered -->
{% if title %}
  <h3 class="mb-3">{{ title }}</h3>
{% endif %}

<div class="category-items">
  {% for row in rows %}
    {{ row.content }}
  {% endfor %}
</div>

{# ✅ PAGER OUTPUT #}
{% if pager %}
  <div class="mt-4">
    {{ pager }}
  </div>
{% endif %}